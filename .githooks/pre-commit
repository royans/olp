#!/usr/bin/env bash
# ==============================================================================
# Git Pre-Commit Security Hook for olp
# Prevents accidental commits of private keys, passkeys, credentials, or sensitive files.
# ==============================================================================
set -euo pipefail

RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m' # No Color

VIOLATIONS=0

echo -e "[git-pre-commit] Scanning staged files for sensitive data and secrets..."

# 1. Check for forbidden filenames
FORBIDDEN_FILE_PATTERNS=(
    "proxy\.toml$"
    "server\.toml$"
    "\.env"
    "id_ed25519"
    "id_rsa"
    "id_ecdsa"
    "authorized_keys"
    "known_proxy"
    "\.pem$"
    "\.key$"
    "\.pkcs8$"
    "\.p12$"
    "\.pfx$"
    "\.secret$"
    "\.passkey$"
)

# Get list of staged files (excluding deletions)
STAGED_FILES=$(git diff --cached --name-only --diff-filter=ACM || true)

if [ -z "$STAGED_FILES" ]; then
    exit 0
fi

while IFS= read -r file; do
    [ -z "$file" ] && continue

    # Allow .example templates and tests
    if [[ "$file" =~ \.example$ ]] || [[ "$file" =~ ^tests/ ]]; then
        continue
    fi

    for pattern in "${FORBIDDEN_FILE_PATTERNS[@]}"; do
        if [[ "$file" =~ $pattern ]]; then
            echo -e "${RED}[ERROR] Attempting to commit forbidden sensitive file:${NC} $file"
            VIOLATIONS=$((VIOLATIONS + 1))
        fi
    done
done <<< "$STAGED_FILES"

# 2. Check for private key content patterns inside staged diffs
# (Matches PEM private keys, OpenSSH private keys, and live passkey assignments)
STAGED_DIFF=$(git diff --cached -U0 || true)

check_diff_pattern() {
    local regex="$1"
    local desc="$2"
    # Match additions (lines starting with '+') excluding diff headers '+++'
    # and exclude .example files, markdown documentation, or tests/
    local matches
    matches=$(git diff --cached -U0 -- . ':(exclude)examples/*' ':(exclude)tests/*' ':(exclude)*.md' 2>/dev/null | grep -E "^\+[[:space:]]*$regex" || true)

    if [ -n "$matches" ]; then
        echo -e "${RED}[ERROR] Detected sensitive pattern ($desc) in staged changes:${NC}"
        echo "$matches" | head -n 5
        VIOLATIONS=$((VIOLATIONS + 1))
    fi
}

check_diff_pattern "[-]+BEGIN [A-Z ]*PRIVATE KEY[-]+" "Private Cryptographic Key"
check_diff_pattern "[-]+BEGIN OPENSSH PRIVATE KEY[-]+" "OpenSSH Private Key"
check_diff_pattern "passkey[[:space:]]*=[[:space:]]*\"[^\"]+\"" "Plaintext Passkey in non-example file"
check_diff_pattern "private_key[[:space:]]*=[[:space:]]*\"[^\"]+\"" "Hardcoded Private Key path or secret"

if [ "$VIOLATIONS" -gt 0 ]; then
    echo ""
    echo -e "${RED}========================================================================${NC}"
    echo -e "${RED} COMMIT BLOCKED: Found $VIOLATIONS potential security violation(s).${NC}"
    echo -e "${YELLOW} Live credentials, private keys, and runtime configs must never be committed.${NC}"
    echo -e "${YELLOW} All runtime data must live in ~/.olp/ or be passed via CLI flags.${NC}"
    echo -e "${YELLOW} If this was a false positive, verify your staged files and diff with: git diff --cached${NC}"
    echo -e "${RED}========================================================================${NC}"
    exit 1
fi

echo -e "${GREEN}[git-pre-commit] Security scan passed cleanly. No secrets detected.${NC}"
exit 0

