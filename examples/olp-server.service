[Unit]
Description=Ollama Proxy Tunnel Client (olp-server)
After=network.target ollama.service

[Service]
Type=simple
# Run as the user running Ollama:
User=ollama
WorkingDirectory=/home/ollama/olp
ExecStart=/home/ollama/olp/target/release/olp-server --non-interactive
Restart=always
RestartSec=5s
LimitNOFILE=65535

# Linux Process Isolation & Security Sandboxing
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/ollama/.olp
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictRealtime=yes

[Install]
WantedBy=multi-user.target

