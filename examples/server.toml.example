# ==============================================================================
# Configuration for `olp-server`
# Location: ~/.olp/server.toml (permissions 0600)
# ==============================================================================

[server]
# Address and port of the public olp-proxy control listener
proxy_addr = "proxy.example.com:4443"

# Local address of the Ollama service to expose
# Note: olp-server automatically queries Ollama and maps client requests to whatever
# model is currently loaded in memory, regardless of what model name the client requests.
ollama_addr = "127.0.0.1:11434"

# User API key recognized by the proxy (matches olp_api_keys in proxy.toml or ~/.olp/config/<olp_api_key>.toml)
olp_api_key = "change-me-to-your-olp-api-key"

# Unique identifier for this server instance (auto-generated e.g. srv_8aBcD123 if empty)
olp_server_id = "srv_my_ollama_box"

# Passkey required by end-users to query Ollama on this server's exposed port.
# Supports HTTP Basic Auth (any-username:passkey_user) or Bearer Token (Authorization: Bearer <passkey_user>).
passkey_user = "change-me-to-a-secure-user-passkey"

# Optional recommended external port to expose on olp-proxy (must fall within proxy's allowed_ports).
# If omitted or already in use, the proxy will dynamically allocate an unused port.
# remote_port = 11434

# TLS CA Certificate Verification (optional, defaults to true for Mozilla WebPKI verification)
# Set to true to enforce Mozilla WebPKI root certificate verification (e.g. Let's Encrypt).
# Set to false only when using self-signed certs over raw IP or internal test environments.
# tls_verify = true

# Sensitive operations / Read-Only Policy control:
# Stricter setting wins!
# - A server can always restrict itself further: setting `read_only = true` ensures mutating
#   operations (pull/delete/create/push/copy/blobs) are blocked both on the proxy and locally on the server,
#   even if the proxy is running with `read_only = false`.
# - Both proxy and server can configure policy as long as they are aligned.
# - Only an attempt by a server to loosen a proxy's stricter policy (proxy RO=true, server RO=false)
#   will abort tunnel registration with CRITICAL CONFIG CONFLICT.
# read_only = true

[reconnect]
# Strategy: "fibonacci" (Fibonacci sequence: 1, 1, 2, 3, 5, 8... up to max_delay_sec with ±10% jitter)
strategy = "fibonacci"
initial_delay_sec = 1
max_delay_sec = 300
heartbeat_interval_sec = 15
heartbeat_timeout_sec = 5

[maintenance]
# Automatic git updates on daily restart / startup.
# Defaults to false for new deployments. When false, olp-server checks git for updates and displays
# a prominent warning banner with a 15-second delayed start if your version is out of sync with remote.
# Set to true to enable automated git pull and rebuild on restarts.
auto_git_pull = false
