# ==============================================================================
# User Profile Configuration for `olp-proxy`
# Location: ~/.olp/config/<olp_api_key>.toml (permissions 0600)
#
# Created automatically on first tunnel connection for an authorized olp_api_key,
# or created manually by proxy administrators.
# ==============================================================================

[user]
# The user's alphanumeric API key (must match file basename <olp_api_key>.toml)
api_key = "TXEVKeIG11rFUhekNvK64qBn"

# Human-readable user or organization name (optional)
name = "admin"

# Maximum number of concurrent servers allowed for this user account (default: 10)
max_servers = 10

# Administrative disable flag: if true, all tunnel registrations and queries are rejected
disabled = false

# Individual server definitions registered by this user account
[servers.srv_Bc9bOUPj]
# Public port assigned to this server by olp-proxy
port = 10000

# Whether this port allocation is permanently reserved for this server_id across proxy restarts
reserved = false

# Secret passkey required by clients to query Ollama through this server's port
passkey_user = "change-me-to-a-secure-user-passkey"

# Allowed IP CIDR blocks for clients querying this server's public HTTP port
allowed_user_cidrs = [
  "0.0.0.0/0",
  "::/0",
]

# Allowed IP CIDR blocks for the private olp-server connecting to the proxy tunnel
allowed_server_cidrs = [
  "0.0.0.0/0",
  "::/0",
]

# Timestamp when this server was first registered
created_at = "07/Nov/2026:04:25:24 +0000"
